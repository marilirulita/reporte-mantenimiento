{
  "expo": {
    "name": "reporte-mantenimiento",
    "slug": "reporte-mantenimiento",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iconMatenimiento.png",
    "scheme": "reportemantenimiento",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/iconResize393x9393.png",
        "backgroundImage": "./assets/images/iconMatenimiento.png",
        "monochromeImage": "./assets/images/iconMatenimiento.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.marilirulita.reportemantenimiento"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/iconMatenimiento.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/iconMatenimiento.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86dc49d7-b621-4944-93a5-4edf37cc73ce"
      }
    },
    "owner": "marilirulita"
  }
}
